+AC_DEFUN([AC_PACKAGE_WANT_FALLOCATE],
+  [ AC_MSG_CHECKING([for fallocate])
+    AC_TRY_LINK([
+#define _GNU_SOURCE
+#define _FILE_OFFSET_BITS 64
+#include <fcntl.h>
+#include <linux/falloc.h> ],
+      [ fallocate(0, 0, 0, 0); ],
+      [ have_fallocate=3Dtrue; AC_MSG_RESULT(yes) ],
+      [ have_fallocate=3Dfalse; AC_MSG_RESULT(no) ])
+    AC_SUBST(have_fallocate)
+  ])
