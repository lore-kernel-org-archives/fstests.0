-#
-#
-# This script emulates bsd install and also recognises
-# two environment variables, with the following semantics :-
-#
-# $DIST_MANIFEST - if set, the name of the file to append manifest
-#                  information in the following format:
-#                  File     :  f mode owner group src target
-#                  Directory:  d mode owner group target
-#                  Symlink  :  l linkval target
-#
-# $DIST_ROOT     - if set, prepend to target
-#
-# The sematics of all combinations of these two variables
-# are as follows:
-#
-# $DIST_MANIFEST?  $DIST_ROOT? |   Copy?  Append Manifest?
-# -----------------------------+--------------------------
-#       not set       not set  |    yes        no
-#       not set       set      |    yes        no
-#       set           not set  |    no         yes
-#       set           set      |    yes        yes
-#
-_usage() {
-    echo "Usage: $prog [-o owner] [-g group] [-m mode] -d directory"
-    echo "or     $prog [-D] [-o owner] [-g group] [-m mode] file directory=
/file"
-    echo "or     $prog [-o owner] [-g group] [-m mode] file [file ...] dir=
ectory"
-    echo "or     $prog -S file target  (creates \"target\" symlink)"
-    echo ""
-    echo "The \$DIST_MANIFEST and \$DIST_ROOT environment variables affect=
 the"
-    echo "behaviour of this command - see comments in the script."
-    echo "The -D flag is only available for the second usage, and causes"
-    echo "the target directory to be created before installing the file."
-    echo ""
-    exit 1
-}
-
-_chown ()
-{
-    _st=3D255
-    if [ $# -eq 3 ] ; then
-	chown $1:$2 $3
-	_st=3D$?
-	if [ $_st -ne 0 ] ; then
-	    if [ $REAL_UID !=3D '0' ] ; then
-		if [ ! -f $DIST_ROOT/.chown.quite ] ; then
-		    echo '=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D'
-		    echo Ownership of files under ${DIST_ROOT:-/}
-		    echo cannot be changed
-		    echo '=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D'
-		    if [ -n "$DIST_ROOT" ] ; then
-			touch $DIST_ROOT/.chown.quite
-		    fi
-		fi
-	       _st=3D0
-	    fi=20=20=20=20=20
-	fi
-    fi
-
-    return $_st
-}
-
-
-_manifest ()
-{=20
-    echo $* | sed -e 's/\/\//\//g' >>${DIST_MANIFEST:-/dev/null}
-}
-
-prog=3D`basename $0`
-HERE=3D`pwd`
-dflag=3Dfalse
-Dflag=3Dfalse
-Sflag=3Dfalse
-DIRMODE=3D755
-FILEMODE=3D644
-OWNER=3D`id -u`
-GROUP=3D`id -g`
-REAL_UID=3D$OWNER
-
-# default is to install and don't append manifest
-INSTALL=3Dtrue
-MANIFEST=3D:
-
-: ${DIST_ROOT:=3D${DESTDIR}}
-
-[ -n "$DIST_MANIFEST" -a -z "$DIST_ROOT" ] && INSTALL=3Dfalse
-[ -n "$DIST_MANIFEST" ] && MANIFEST=3D"_manifest"
-
-[ $# -eq 0 ] && _usage
-
-if $INSTALL
-then
-    CP=3Dcp; LN=3Dln; MKDIR=3Dmkdir; CHMOD=3Dchmod; CHOWN=3D_chown
-else
-    CP=3Dtrue; LN=3Dtrue; MKDIR=3Dtrue; CHMOD=3Dtrue; CHOWN=3Dtrue
-fi
-
-[ -n "$DIST_ROOT" -a $REAL_UID -ne 0 ] && CHOWN=3Dtrue
-
-while getopts "Dcm:d:S:o:g:" c $*
-do
-   case $c in
-   c)
-	;;
-   g)
-	GROUP=3D$OPTARG
-	;;
-   o)
-	OWNER=3D$OPTARG
-	;;
-   m)
-	DIRMODE=3D`expr $OPTARG`
-	FILEMODE=3D$DIRMODE
-	;;
-   D)=20
-	Dflag=3Dtrue
-	;;
-   S)=20
-	symlink=3D$OPTARG
-	Sflag=3Dtrue
-	;;
-   d)=20
-	dir=3D$DIST_ROOT/$OPTARG
-	dflag=3Dtrue
-	;;
-   *)
-   	_usage
-	;;
-   esac
-done
-
-shift `expr $OPTIND - 1`
-
-status=3D0
-if $dflag
-then
-    #
-    # first usage
-    #
-    $MKDIR -p $dir=20
-    status=3D$?
-    if [ $status -eq 0 ]
-    then
-	$CHMOD $DIRMODE $dir
-	status=3D$?
-    fi
-    if [ $status -eq 0 ]
-    then
-	$CHOWN $OWNER $GROUP $dir
-	status=3D$?
-    fi
-    $MANIFEST d $DIRMODE $OWNER $GROUP ${dir#$DIST_ROOT}
-elif $Sflag
-then
-    #
-    # fourth usage (symlink)
-    #
-    if [ $# -ne 1 ]
-    then
-    	_usage
-    else
-    	target=3D$DIST_ROOT/$1
-    fi
-    $LN -s -f $symlink $target
-    status=3D$?
-    $MANIFEST l $symlink ${target#$DIST_ROOT}=20
-else
-    list=3D""
-    dir=3D""
-    if [ $# -eq 2 ]
-    then
-	#
-	# second usage
-	#
-	f=3D$1
-	dir=3D$DIST_ROOT/$2
-	if $Dflag
-	then
-	    mkdir -p `dirname $dir`
-	fi
-	$CP $f $dir
-	status=3D$?
-	if [ $status -eq 0 ]
-	then=20
-	    if [ -f $dir/$f ]
-	    then
-		$CHMOD $FILEMODE $dir/$f
-		status=3D$?
-		if [ $status -eq 0 ]
-		then
-		    $CHOWN $OWNER $GROUP $dir/$f
-		    status=3D$?
-		fi
-		$MANIFEST f $FILEMODE $OWNER $GROUP $HERE/$f ${dir#$DIST_ROOT}/$f
-	    else
-		$CHMOD $FILEMODE $dir
-		status=3D$?
-		if [ $status -eq 0 ]
-		then
-		    $CHOWN $OWNER $GROUP $dir
-		    status=3D$?
-		fi
-		$MANIFEST f $FILEMODE $OWNER $GROUP $HERE/$dir ${dir#$DIST_ROOT}
-	    fi
-	fi
-    else
-	#
-	# third usage
-	#
-	n=3D1
-	while [ $# -gt 0 ]
-	do
-	    if [ $# -gt 1 ]
-	    then
-		list=3D"$list $1"
-	    else
-		dir=3D$DIST_ROOT/$1
-	    fi
-	    shift
-	done
-
-	# echo DIR=3D$dir list=3D\"$list\"
-	for f in $list
-	do
-	    $CP $f $dir
-	    status=3D$?
-	    if [ $status -eq 0 ]
-	    then
-		$CHMOD $FILEMODE $dir/$f
-		status=3D$?
-		if [ $status -eq 0 ]
-		then
-		    $CHOWN $OWNER $GROUP $dir/$f
-		    status=3D$?
-		fi
-		$MANIFEST f $FILEMODE $OWNER $GROUP $HERE/$f ${dir#$DIST_ROOT}/$f
-	    fi
-	    [ $status -ne 0 ] && break
-	done
-    fi
-fi
-
-exit $status
